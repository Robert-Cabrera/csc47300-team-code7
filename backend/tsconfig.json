{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["server.ts", "routes/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules"]
}
