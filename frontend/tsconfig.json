{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
  "allowJs": false,
    "outDir": "./dist",
    "rootDir": "./scripts",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
      "scripts/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "scripts/**/*.js"
    ]
}
