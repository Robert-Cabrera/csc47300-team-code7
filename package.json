{
  "scripts": {
    "start": "node backend/dist/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"wait-on http://localhost:3000 && npm run dev:react\"",
    "dev:backend": "npm run build:backend && node backend/dist/server.js",
    "dev:react": "npm --prefix react run dev",
    "build": "npm run build:frontend && npm run build:backend && npm run build:react",
    "build:frontend": "npm run clean:frontend && tsc -p frontend/tsconfig.json",
    "build:backend": "npm run clean:backend && tsc -p backend/tsconfig.json",
    "build:react": "npm --prefix react run build",
    "clean:frontend": "rimraf frontend/dist",
    "clean:backend": "rimraf backend/dist",
    "watch:frontend": "tsc -p frontend/tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.23",
    "concurrently": "^8.2.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@langchain/google-genai": "^1.0.0",
    "@supabase/supabase-js": "^2.81.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "langchain": "^1.0.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "path-to-regexp": "^8.3.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.1.12"
  }
}
